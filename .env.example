# Tingly Box Docker Deployment — Environment Variables
# Copy this file to .env and fill in your values.
# Add any additional env vars your config.json references (API keys, MCP settings, etc.)

# ── Tingly Box Server ──
TINGLY_VERSION=latest
TINGLY_HOST=0.0.0.0
TINGLY_PORT=12580
TINGLY_DEBUG=false

# Token tingly-box uses to authenticate its own API. Required; used by
# VisionBridge (below) to talk back into tingly-box's OpenAI endpoint.
TINGLY_MODEL_TOKEN=

# ── VisionBridge (optional companion) ──
# VisionBridge is an OpenAI-compatible proxy that gives text-only LLMs vision
# by pairing a reasoning model with a separate vision model. Both route through
# tingly-box so routing/load-balancing/OAuth/rate-limits/usage stay centralized.
# Clients do NOT call VisionBridge directly — they request the bridge model
# through tingly-box. Set the reasoning/vision models to tingly-box rules you
# define (e.g. your normal text model + a vision-capable model).
VISIONBRIDGE_SCENARIO=custom
VISIONBRIDGE_REASONING_MODEL=
VISIONBRIDGE_VISION_MODEL=
VISIONBRIDGE_MODEL_NAME=visionbridge
VISIONBRIDGE_SCENE_PRIMING=true
VISIONBRIDGE_MAX_VISION_CALLS=8
VISIONBRIDGE_TOOL_MODE=auto
# Upstream commit SHA to build VisionBridge from (bump to track upstream main)
VISIONBRIDGE_SHA=92c793feaee0df688a20cf71c4f135ba00ef9bd2